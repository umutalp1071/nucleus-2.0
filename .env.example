# Copy to .env.local (gitignored) and fill in what you have.
# Nucleus runs with none of these set -- it falls back to a deterministic
# mock AI provider and mock deploy target, so the app is fully usable with
# zero accounts and zero keys.

# BYOK: an OpenRouter API key (https://openrouter.ai/keys). Adding this in
# Settings at runtime works too and takes effect immediately -- you do not
# need to set it here or restart the server.
OPENROUTER_API_KEY=

# Only needed for real deploys of the generated landing page (Phase 08+).
VERCEL_TOKEN=

# Where Nucleus stores its JSON data. Defaults to ./.nucleus if unset.
NUCLEUS_DATA_DIR=.nucleus
